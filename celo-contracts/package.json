{
  "name": "celo-contracts",
  "version": "1.0.0",
  "license": "MIT",
  "description": "KoraRegistry Solidity contract for the Celo network",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/iam-mercy/kora-app.git",
    "directory": "celo-contracts"
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint --max-warnings 0 'contracts/**/*.sol'",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:dev": "npm audit --audit-level=high",
    "audit": "npm run audit:prod && npm run audit:dev"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0",
    "solhint": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "@openzeppelin/contracts": "^5.6.1"
  }
}
